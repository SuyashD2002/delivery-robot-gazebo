  <link name="Lidar_Link">
    <inertial>
      <origin xyz="0 -0.00999999999999979 0.0246211011808657" rpy="0 0 0" />
      <mass value="0.386258351720988" />
      <inertia ixx="0.000316464082694034" ixy="-7.26205566103317E-37" ixz="1.75071990168499E-20" iyy="0.000316464082694034" iyz="-7.12755178509545E-37" izz="0.000476111514703906" />
